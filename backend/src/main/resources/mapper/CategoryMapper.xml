<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.qa.mapper.CategoryMapper">

    <sql id="Base_Column_List">
        id, name, description, create_time
    </sql>

    <select id="selectAll" resultType="com.campus.qa.entity.Category">
        SELECT <include refid="Base_Column_List"/> FROM t_category ORDER BY create_time DESC
    </select>

    <select id="selectById" resultType="com.campus.qa.entity.Category">
        SELECT <include refid="Base_Column_List"/> FROM t_category WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.campus.qa.entity.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_category (name, description, create_time)
        VALUES (#{name}, #{description}, NOW())
    </insert>

    <update id="update" parameterType="com.campus.qa.entity.Category">
        UPDATE t_category
        SET name = #{name}, description = #{description}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_category WHERE id = #{id}
    </delete>

    <select id="countPost" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_post WHERE category_id = #{id}
    </select>
</mapper>
