<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.qa.mapper.CommentMapper">

    <sql id="vo_select">
        SELECT cm.id, cm.post_id, cm.user_id, cm.content, cm.create_time,
               u.username, u.avatar
        FROM t_comment cm
        LEFT JOIN t_user u ON cm.user_id = u.id
    </sql>

    <resultMap id="CommentVOMap" type="com.campus.qa.dto.CommentVO">
        <id column="id" property="id"/>
        <result column="post_id" property="postId"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
        <result column="username" property="username"/>
        <result column="avatar" property="avatar"/>
    </resultMap>

    <insert id="insert" parameterType="com.campus.qa.entity.Comment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_comment (post_id, user_id, content, create_time)
        VALUES (#{postId}, #{userId}, #{content}, NOW())
    </insert>

    <select id="selectById" resultType="com.campus.qa.entity.Comment">
        SELECT id, post_id, user_id, content, create_time FROM t_comment WHERE id = #{id}
    </select>

    <select id="selectVOByPostId" resultMap="CommentVOMap">
        <include refid="vo_select"/>
        WHERE cm.post_id = #{postId}
        ORDER BY cm.create_time ASC
    </select>

    <select id="selectVOByUserId" resultMap="CommentVOMap">
        <include refid="vo_select"/>
        WHERE cm.user_id = #{userId}
        ORDER BY cm.create_time DESC
    </select>

    <select id="selectVOAll" resultMap="CommentVOMap">
        <include refid="vo_select"/>
        <where>
            <if test="keyword != null and keyword != ''">
                (cm.content LIKE CONCAT('%', #{keyword}, '%')
                 OR u.username LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY cm.create_time DESC
    </select>

    <delete id="deleteById">
        DELETE FROM t_comment WHERE id = #{id}
    </delete>

    <delete id="deleteByPostId">
        DELETE FROM t_comment WHERE post_id = #{postId}
    </delete>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_comment
    </select>
</mapper>
