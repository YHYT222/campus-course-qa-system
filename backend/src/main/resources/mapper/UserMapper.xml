<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.qa.mapper.UserMapper">

    <sql id="Base_Column_List">
        id, student_no, username, password, role, avatar, create_time
    </sql>

    <select id="selectById" resultType="com.campus.qa.entity.User">
        SELECT <include refid="Base_Column_List"/> FROM t_user WHERE id = #{id}
    </select>

    <select id="selectByStudentNo" resultType="com.campus.qa.entity.User">
        SELECT <include refid="Base_Column_List"/> FROM t_user WHERE student_no = #{studentNo} LIMIT 1
    </select>

    <select id="selectByUsername" resultType="com.campus.qa.entity.User">
        SELECT <include refid="Base_Column_List"/> FROM t_user WHERE username = #{username} LIMIT 1
    </select>

    <select id="selectByKeyword" resultType="com.campus.qa.entity.User">
        SELECT <include refid="Base_Column_List"/> FROM t_user
        <where>
            <if test="keyword != null and keyword != ''">
                (student_no LIKE CONCAT('%', #{keyword}, '%')
                OR username LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectAll" resultType="com.campus.qa.entity.User">
        SELECT <include refid="Base_Column_List"/> FROM t_user ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.campus.qa.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user (student_no, username, password, role, avatar, create_time)
        VALUES (#{studentNo}, #{username}, #{password}, #{role}, #{avatar}, NOW())
    </insert>

    <update id="update" parameterType="com.campus.qa.entity.User">
        UPDATE t_user
        <set>
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="role != null and role != ''">role = #{role},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_user WHERE id = #{id}
    </delete>

    <select id="countAll" resultType="java.lang.Long">
        SELECT COUNT(*) FROM t_user
    </select>
</mapper>
